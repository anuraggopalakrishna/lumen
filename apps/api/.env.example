# Lumen API environment
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# PostgreSQL source of truth
DATABASE_URL=postgres://lumen:lumen@localhost:5432/lumen

# Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated allow-list, or * for local development only
CORS_ORIGINS=*

# Background worker cadence
WORKER_INTERVAL_SECONDS=3600

# --- Local inference boundary (§9) -----------------------------------------
# Keep generation OFF until a private Ollama host and an allow-listed model are
# in place. Never point OLLAMA_BASE_URL at a hosted/cloud endpoint for health data.
AI_GENERATION_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=60000
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096
