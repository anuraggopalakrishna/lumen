# Docker Compose environment for local and single-host deployments.
# Copy to .env and change these before exposing anything publicly.

POSTGRES_USER=lumen
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lumen
POSTGRES_PORT=5432

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-32-plus-character-random-secret

# Comma-separated allow-list in production. Never leave as *.
CORS_ORIGINS=*

API_PORT=4000

# --- Local inference boundary -------------------------------------------------
# Keep generation OFF until a private Ollama host and an allow-listed model are
# in place. OLLAMA_BASE_URL must point at that private host, never a cloud API.
AI_GENERATION_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_PORT=11434
